extends ../ui_layout-esp

block content
  -var cdn = "https://dhpd030vnpk29.cloudfront.net";
  .ui.text.container
    br
    .ui.raised.segment
      h3.ui.header
        i.wechat.icon
        .content
          | Alguien que no conoces personalmente, pero es amigo de un amigo te envía el siguiente mensaje.
      hr 
      #introduction_next.button.ui.mini.green.right.labeled.icon.button
              i.eye.icon
              |   Ver Mensajes


    #show_steps.ui.segment.hidden
      //- .ui.header.title
      a.ui.blue.ribbon.label#clickHereToSee
        h4
          i.hand.pointer.icon
          content Haz clic aquí para ver formas de responder al mensaje.

      br
      br
      #steps.ui.stackable.two.column.grid.hidden
        .ui.column
          #step1.ui.raised.segment.voiceover_keyTerm1
            a.ui.blue.ribbon.label#step1Label
                span Ignorar a la persona
            span.hidden.responseSuggestion(id="step1_info") 
              | ¡Ignorar a la persona siempre es una opción!
              | No debes compartir información privada con alguien que no conoces en la vida real.

        .ui.column
          #step2.ui.raised.segment.voiceover_keyTerm2
            a.ui.blue.ribbon.label#step2Label
                span Cambiar de tema
            span.hidden.responseSuggestion(id="step2_info") 
              | Una cosa que puedes hacer es cambiar de tema.
        
        .ui.column
          #step3.ui.raised.segment.voiceover_keyTerm3
            a.ui.blue.ribbon.label#step3Label
                span Ser directo
            span.hidden.responseSuggestion(id="step3_info") 
              | Intenta decir “No te conozco. No me siento cómodo dándote mi dirección.”
        
        .ui.column
          #step4.ui.raised.segment.voiceover_keyTerm4
            a.ui.blue.ribbon.label#step4Label
                span Habla con un adulto de confianza
            span.hidden.responseSuggestion(id="step4_info") 
             | Siempre es útil recibir consejos de alguien en quien confíes.
    
    #chat1.container.clearfix.hidden
      .chat
        .chat-header.clearfix
          //-making close button have minimize functionality so user can't accidentally close the chat and not be able to reference it
          a.chat-minimize(href='#')
            i.large.close.icon
          a.chat-minimize(href='#')
            i.window.minimize.icon

          a(href='#')
            img.ui.avatar.image(src=cdn+'/profile_pictures/user21.jpg',style="width: 3em;height: 3em;")
          .chat-about
            .chat-with Chateando con Thiago Fernández
            //- .chat-num-messages already 1 902 messages
          //- i.fa.fa-star
        // end chat-header
        .chat-history
          ul
            li.clearfix
              .message-data
                span.message-data-name 
                  i.dot.circle.icon.online
                  | Sam 
                span.message-data-time 10:12 AM
              .message.my-message
                | Hola, tu amiga me dio tu número.
            li
              .message-data
                span.message-data-name
                  i.dot.circle.icon.online
                  |  Sam 
                span.message-data-time 10:12 AM
              .message.my-message
                | Dijo que te gustaba mucho el baloncesto.
            li
              .message-data
                span.message-data-name
                  i.dot.circle.icon.online
                  |  Sam 
                span.message-data-time 10:20 AM
              .message.my-message
                | ¿Cuál es tu dirección para que pueda pasar después de la escuela a jugar al baloncesto contigo?

        // end chat-history
        .chat-message.clearfix
          .ui.fluid.action.input
            input#message-to-send(type='text', name='message-to-send', placeholder='Escribe tu mensaje')
            button
              i.blue.send.icon
              | Enviar
        // end chat-message
        // end chat
    // end container
    script()#message-template(type='text/x-handlebars-template').
      <li class="clearfix">
      <div class="message-data align-right">
      <span class="message-data-time" >{{time}}</span> &nbsp; &nbsp;
      <span class="message-data-name" >Yo</span> <i class="dot circle icon me"></i>
      </div>
      <div class="message other-message float-right">
      {{messageOutput}}
      </div>
      </li>
    script()#message-response-template(type='text/x-handlebars-template').
      <li>
      <div class="message-data">
      <span class="message-data-name"><i class="fa fa-circle online"></i> Vincent</span>
      <span class="message-data-time">{{time}}</span>
      </div>
      <div class="message my-message">
      {{response}}
      </div>
      </li>

    br
    .ui.warning.message#clickViewMessagesWarning
      .header
       | Has clic en \"Ver mensajes\"
    .ui.warning.message#clickToSeeWarning
     .header
      | Haz clic en el recuadro azul para ver formas de responder al mensaje
    .ui.warning.message#clickLabelsWarning
     .header
      | Dale clic a cada etiqueta para continuar
    .ui.big.labeled.icon.button.cybersim#safepostSimButton
        i.rocket.icon
        |   ¡Entendido!
    br
    br
    br
    
block scripts
  script.
    var voiceoverMappings = {
      '.voiceover_keyTerm1': {
        "initialDelay": 700,
        "delay": 0,
        "files": ['CUSML.11.4.1.mp3']
      },
      '.voiceover_keyTerm2': {
        "initialDelay": 700,
        "delay": 0,
        "files": ['CUSML.11.4.2.mp3']
      },
      '.voiceover_keyTerm3': {
        "initialDelay": 700,
        "delay": 0,
        "files": ['CUSML.11.4.3.mp3']
      },
      '.voiceover_keyTerm4': {
        "initialDelay": 700,
        "delay": 0,
        "files": ['CUSML.11.4.4.mp3']
      }
    };
  script(src='/module_js/voiceover.js')
  script(src="/module_js/safe-posting/safe-posting_tut_guide.js")
  script(src=cdn+'/js/chatbox2.js')
  
block styles
  link(rel='stylesheet', href='/css/modules/safe-posting.css')
  link(rel='stylesheet', href='/css/chatbox.css')
  
