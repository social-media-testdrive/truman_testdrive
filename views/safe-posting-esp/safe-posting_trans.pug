extends ../ui_layout-esp

block content

  .ui.text.container.addBottomMargin
    br
    .column
      .ui.raised.segment
        .ui.blue.ribbon.label
          h3
            i.history.icon
            | &nbsp Repasemos!
        br
        .ui.mini.green.right.labeled.icon.button.showReviewSectionButton
          i.down.arrow.icon
          |   Siguiente  
        .ui.basic.segment.reviewSegment.hidden
          h5.ui.header
            i.arrow.circle.right.blue.icon
            .content
              | En tus redes sociales puedes tener a varias personas que no conoces muy bien. 
              | Por eso, no debes compartir en línea datos como tu nombre completo, 
              | dirección o número de teléfono.
          
          h5.ui.header
            i.arrow.circle.right.blue.icon
            .content 
              | Si alguien en línea te pregunta sobre tu información privada, sobretodo 
              | alguien que no conoces, debes tener cuidado! Cuando esto sucede, es 
              | importante pausar y pensar en la situación. Puedes responder haciendo 
              | lo siguiente
          
          br
        
    br
    br
    .ui.warning.message.clickNextWarning.hidden
      .header
       | Clic \"Siguiente\"
    a(href='javascript:void(0);', onclick='javascript:clickGotIt();')
        .ui.big.green.labeled.icon.button
            i.rocket.icon
            |   ¡Entendido!
            
block scripts
  script().
    var voiceoverMappings = {
      '.showReviewSectionButton': {
        "initialDelay": 700,
        "delay": 500,
        "files": ['CUSML.11.6.1.mp3', 'CUSML.11.6.2.mp3']
      }
    };
    var nextPage = 'trans_script';
  script(src="/module_js/voiceover.js")  
  script(src="/module_js/base_trans.js")
  
block styles
  link(rel='stylesheet', href='/css/trans.css')  
