
extends ../ui_layout-esp

block content
  
  style.
    body {
      overflow: hidden; 
    }

  -var cdn = "https://dhpd030vnpk29.cloudfront.net";
  .computer.only.tablet.only.four.wide.column 
  #content.eight.wide.computer.ten.wide.tablet.sixteen.wide.mobile.column

    .ui.fluid.card.dim()#step1
      .ui.dimmer.flag
        .content
          .center
            h2.ui.inverted.icon.header
              i.red.flag.icon
              | ¡Has reportado esto!
              h3.ui.inverted.header
                span 
                  | Los administradores del TestDrive van a revisar el post luego. Lamentamos que 
                  | hayas tenido esta experiencia.
      .content
        .right.floated.meta= "Ayer"
        a(href='#')
              img.ui.avatar.image(src=cdn+'/profile_pictures/user21.jpg')
              span='David Cole'
      .image
        img.post(src=cdn+'/post_pictures/safepostpic.png')
      .content           
          .description="Fui de excursión con mi mamá este fin de semana."
      .three.ui.bottom.attached.icon.buttons
        .ui.reply.button(tabindex='0')
          i.reply.icon
          | Responder
        .ui.flag.button(tabindex='0')
          i.flag.icon
          | Reportar
        .ui.labeled.button(tabindex='0')
          .ui.like.button
            i.heart.icon
            | Like
          a.ui.basic.red.left.pointing.label.count 2
      .content
        .ui.comments
          .comment()
            a.avatar
              img(src=cdn+'/profile_pictures/user24.jpg')
            .content
              a.author Jenny Chen
              .metadata
                span.date Ayer
                .rating
                  i.heart.icon
                  span.num=1
                  |  Likes
              .text se ve divertido! 😍
              .actions
                a.like.comment Like
                a.flag.comment Reportar
      .extra.content
        .ui.fluid.left.labeled.right.icon.input
          .ui.label
            if user && user.profile && user.profile.picture
              img.ui.avatar.image(src=cdn+'/profile_pictures/'+user.profile.picture, name=user.profile.name)
            else
              img.ui.avatar.image(src=cdn+'/profile_pictures/avatar-icon.svg', name='Usuario')
          input.newcomment(type='text' placeholder='Escribe un comentario')
          i.big.send.link.icon
    //-#######################

    .container.clearfix
      .chat#step2
        .chat-header.clearfix
          //-Making both buttons a minimize action. If user closes chat before tooltip highlights, tooltip bugs out. 
          a.chat-minimize(href='#')
            i.large.close.icon
          a.chat-minimize(href='#')
            i.window.minimize.icon

          a(href='#')
            img.ui.avatar.image(src=cdn+'/profile_pictures/user21.jpg')
          .chat-about
            .chat-with Chateando con Thiago Fernández
        // end chat-header
        .chat-history
          ul
            li
              .message-data
                span.message-data-name 
                  i.dot.circle.icon.online
                  | Sam 
                span.message-data-time 10:12 AM
              .message.my-message
                | hey! Me gustan mucho tus fotos.
            li
              .message-data
                span.message-data-name
                  i.dot.circle.icon.online
                  |  Sam 
                span.message-data-time 10:12 AM
              .message.my-message
                | No lo sé, pero pareces genial 😎 cuéntame sobre ti
            li
              .message-data
                span.message-data-name
                  i.dot.circle.icon.online
                  |  Sam 
                span.message-data-time 10:20 AM
              .message.my-message
                | ¿a qué escuelas vas?
        // end chat-history
        .chat-message.clearfix
          .ui.fluid.action.input
            input#message-to-send(type='text', name='message-to-send', placeholder='Escribe tu mensaje')
            button
              i.send.icon
              | Enviar
        // end chat-message
        // end chat
    // end container
    script()#message-template(type='text/x-handlebars-template').
      <li class="clearfix">
      <div class="message-data align-right">
      <span class="message-data-time" >{{time}}</span> &nbsp; &nbsp;
      <span class="message-data-name" >Yo</span> <i class="fa fa-circle me"></i>
      </div>
      <div class="message other-message float-right">
      {{messageOutput}}
      </div>
      </li>
    script()#message-response-template(type='text/x-handlebars-template').
      <li>
      <div class="message-data">
      <span class="message-data-name"><i class="fa fa-circle online"></i> Vincent</span>
      <span class="message-data-time">{{time}}</span>
      </div>
      <div class="message my-message">
      {{response}}
      </div>
      </li>


block scripts
  script(src='/postFunctionalities.js')
  script(src=cdn+'/js/chatbox2.js')
  script(src="/module_js/safe-posting-esp/safe-posting-esp_tutorial.js")
  script(src='/module_js/voiceover.js')
  script(src="/module_js/base_introSteps.js")
  script(src='/module_js/base_tutorial.js')
  
block styles
  link(rel='stylesheet', href='/css/modules/safe-posting.css')
  link(rel='stylesheet', href='/css/chatbox.css')
    
