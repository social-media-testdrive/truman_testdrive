extends ../ui_layout-esp

block content
  -var cdn = "https://dhpd030vnpk29.cloudfront.net";
  .ui.container.addBottomMargin
    .ui.stackable.column.grid
      .ui.column
        .insertPrint
        .ui.raised.segment.reflectionTopSegment
          h3.ui.header
            i.question.blue.icon
            .content
              | Reflexionar
          
          .ui.mini.green.right.labeled.icon.button.reflectionSegmentButton.voiceover_reflection1
            i.down.arrow.icon
            |   Comenzar
          .ui.basic.segment.reflectionPromptSegment.hidden.noPadding.selectPostsQuestion1  
            .ui.label.resultsPromptLabel
              h4
                i.exclamation.triangle.icon.yellowIcon
                | Estas fueron las publicaciones con información privada en el feed. ¿Cuántas notaste?
            h3.grayElement
              i.hand.pointer.icon
              | ¡Haz clic en las que notaste!
            .ui.stackable.three.cards.selectablePosts
              
              .ui.fluid.card.dim()#card1
                .content
                  .right.floated.meta Hace 20 minutos  
                  a(href='/user/zoe.g._')
                    img.ui.avatar.image(src=cdn+'/profile_pictures/user70.JPG')
                    span Zoe Goodall
                .img.post
                  img.transition.visible(src=cdn+'/post_pictures/safepostga2.jpg', data-src='/safepostga2.jpg')
                .content
                  .description.
                    Tengo un nuevo número de teléfono!😊 Es (+56)607-252-6771

              .ui.fluid.card.dim()#card2
                .content
                  .right.floated.meta Hace 30 minutos
                  a(href='/user/ethan-the-man')
                    img.ui.avatar.image(src=cdn+'/profile_pictures/user18.png')
                    span Ethan Kravitz
                .img.post
                  img.transition.visible(src=cdn+'/post_pictures/coolmovies.jpeg', data-src='/coolmovies.jpeg')
                .content
                  .description.
                    ¡¡Estaré en el Espaço Itaú de Cinema ESTE VIERNES para ver la nueva película de Marvel!! Nos vemos ahí a las 8 🎥🍿


              .ui.fluid.card.dim()#card3
                .content
                  .right.floated.meta Hace una hora
                  a(href='/user/jasmine_1110')
                    img.ui.avatar.image(src=cdn+'/profile_pictures/user57.jpg')
                    span Francisca Ferreira
                .img.post
                  img.transition.visible(src=cdn+'/post_pictures/house.jpg', data-src='/house.jpg')
                .content
                  .description.
                    321 Avenida Rodrigues Alves, vengan a pasar el rato chicas, estoy aburrida.

        .ui.basic.segment.noPadding.hidden.reflectionTopSegment
          .ui.raised.segment
            .ui.mini.green.right.labeled.icon.button.reflectionSegmentButton.voiceover_reflection2
              i.down.arrow.icon
              |   Siguiente
            .ui.basic.segment.noPadding.reflectionPromptSegment.hidden
              .ui.label.resultsPromptLabel
                h4.reflectionCheckboxesPrompt(data-questionNumber='Q1')
                  | #{reflectionData['safe-posting'].Q1.prompt}
              .ui.stackable.two.cards.checkOne
                .ui.fluid.card.dim()#card3
                    .content
                      .right.floated.meta Hace una hora
                      a(href='/user/jasmine_1110')
                        img.ui.avatar.image(src=cdn+'/profile_pictures/user57.jpg')
                        span Jasmine Woolley
                    .img.post
                      img.transition.visible(src=cdn+'/post_pictures/house.jpg', data-src='/house.jpg')
                    .content
                      .description.
                        ¡321 Avenida Jefferson, vengan a pasar el rato! Estoy aburrida.

                .ui.fluid.card.dim()
                  .content
                    .ui.form
                      .inline.fields
                        label(for='privateInfo', name='privateInfo') 
                        .field
                          .ui.checkbox
                            input(type='checkbox')
                            label(for='privateInfo', tabindex='0')
                              | #{reflectionData['safe-posting'].Q1.checkboxLabels[0]}
                    hr
                    .ui.form
                      .inline.fields
                        label(for='think', name='think') 
                        .field
                          .ui.checkbox
                            input(type='checkbox')
                            label(for='think', tabindex='0')
                              | #{reflectionData['safe-posting'].Q1.checkboxLabels[1]}
                    hr
                    .ui.form
                      .inline.fields
                        label(for='think', name='think') 
                        .field
                          .ui.checkbox
                            input(type='checkbox')
                            label(for='think', tabindex='0')
                              | #{reflectionData['safe-posting'].Q1.checkboxLabels[2]}
            
        .ui.basic.segment.noPadding.hidden.reflectionTopSegment
          .ui.raised.segment
            .ui.mini.green.right.labeled.icon.button.reflectionSegmentButton.voiceover_reflection3
              i.down.arrow.icon
              |   Siguiente
            .ui.basic.segment.noPadding.reflectionPromptSegment.hidden
              .ui.label.resultsPromptLabel
                h4.reflectionCheckboxesPrompt(data-questionNumber='Q2')
                  | #{reflectionData['safe-posting'].Q2.prompt}
              .ui.stackable.two.cards.checkTwo
                .ui.fluid.card.dim()#card3
                  .content
                    .chat
                      .chat-history
                        ul
                          li.clearfix
                            .message-data
                              span.message-data-name 
                                i.dot.circle.icon.online
                                | Jack 
                              span.message-data-time 10:12
                            .message.my-message
                              | Hola, tengo una pregunta sobre la tarea de mañana
                          li
                            .message-data
                              span.message-data-name
                                i.dot.circle.icon.online
                                |  Jack 
                              span.message-data-time 10:12
                            .message.my-message
                              | ¿Me puedes dar tu número para llamarte rápido?                 

                .ui.fluid.card.dim()#card3
                  .content
                    .ui.form
                      .inline.fields
                        label(for='changeSub', name='changeSub') 
                        .field

                          .ui.checkbox
                            input(type='checkbox')
                            label(for='changeSub', tabindex='0')
                              | #{reflectionData['safe-posting'].Q2.checkboxLabels[0]}
                    hr
                    .ui.form
                      .inline.fields
                        label(for='humor', name='humor') 
                        .field

                          .ui.checkbox
                            input(type='checkbox')
                            label(for='humor', tabindex='0')
                              | #{reflectionData['safe-posting'].Q2.checkboxLabels[1]}

                    hr
                    .ui.form
                      .inline.fields
                        label(for='ignore', name='ignore') 
                        .field
                          .ui.checkbox
                            input(type='checkbox')
                            label(for='ignore', tabindex='0')
                              | #{reflectionData['safe-posting'].Q2.checkboxLabels[2]}
                            
                    hr
                    .ui.form
                      .inline.fields
                        label(for='direct', name='direct') 
                        .field
                          .ui.checkbox
                            input(type='checkbox')
                            label(for='direct', tabindex='0')
                              | #{reflectionData['safe-posting'].Q2.checkboxLabels[3]}
                  
                    hr
                    .ui.form
                      .inline.fields
                        label(for='somethingElse', name='somethingElse') 
                        .field
                          .ui.checkbox
                            input(type='checkbox')
                            label(for='somethingElse', tabindex='0')
                              | #{reflectionData['safe-posting'].Q2.checkboxLabels[4]}
    
        .ui.basic.segment.noPadding.hidden.reflectionTopSegment
          .ui.raised.segment
            .ui.mini.green.right.labeled.icon.button.reflectionSegmentButton.voiceover_reflection4
              i.down.arrow.icon
              | Siguiente
            .ui.basic.segment.noPadding.reflectionPromptSegment.hidden.checkThree 
              .ui.label.resultsPromptLabel
                h4.reflectionPrompt(data-questionNumber='Q3')
                  | #{reflectionData['safe-posting'].Q3.prompt}
              .ui.form
                .inline.fields
                  label
                  textarea.glowing-border(rows='3' id="safe_responseOne")
    .ui.warning.message.hidden.startPromptsWarning
      .header
        | Haz clic en "Comenzar"
    .ui.warning.message.hidden.openAllPromptsWarning
      .header
        | Haz clic en "Siguiente"
    //- include ../partials/optInToShareActivityData.pug
    br
    .ui.big.labeled.icon.button.results_print(onclick="onPrint()")
          i.right.arrow.icon
          |   Imprimir tus respuestas
    br
    br
    .ui.big.labeled.icon.button.resultsContinueButton
          i.rocket.icon
          |   Continuar

      
block scripts
  script.
    var voiceoverMappings = {
      '.voiceover_reflection1': {
        "initialDelay": 500,
        "delay": 0,
        "files": ['CUSML.11.7.1.mp3']
      },
      '.voiceover_reflection2': {
        "initialDelay": 500,
        "delay": 0,
        "files": ['CUSML.11.7.2.mp3']
      },
      '.voiceover_reflection3': {
        "initialDelay": 500,
        "delay": 0,
        "files": ['CUSML.11.7.3.mp3']
      },
      '.voiceover_reflection4': {
        "initialDelay": 500,
        "delay": 0,
        "files": ['CUSML.11.7.4.mp3']
      }
    };
  script(src="/module_js/safe-posting-esp/safe-posting-esp_results.js")
  script(src='/module_js/base_results.js?v=1')
  script(src='/module_js/voiceover.js')
  
block styles 
  link(rel='stylesheet', href='/css/modules/safe-posting.css')
  link(rel='stylesheet', href='/css/results.css') 
