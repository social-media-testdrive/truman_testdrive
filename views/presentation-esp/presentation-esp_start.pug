extends ../ui_layout-esp

//- presentation-esp learn start (es); plantilla solo en castellano
block content

  .ui.text.container.addBottomMargin
    br
    .ui.raised.segment
      h3.ui.header
        i.book.blue.icon
        .content
          | Aprender
      hr
      .ui.basic.segment.removePadding
        .ui.mini.green.right.labeled.icon.button.showLearnSectionButton
          i.down.arrow.icon
          |   Siguiente
      .ui.basic.segment.learnSegment.hidden
        h5.ui.header
          i.arrow.circle.right.blue.icon
          .content
            | Publicar en redes sociales puede ser una buena forma de mostrar quién eres.
            | Puedes ser tú mismo y compartir tus ideas con otras personas.
        h5.ui.header
          i.arrow.circle.right.blue.icon
          .content
            | A veces la gente también tiene cuentas falsas. Se llaman
            | <b>finstas</b> o cuentas basura (spam). Algunas personas las usan para hablar con
            | quienes comparten sus mismos intereses, o para publicar cosas que solo quieren que vean sus amigos cercanos.
        br
        .ui.mini.green.right.labeled.icon.button.showKeyTermsButton
          i.down.arrow.icon
          |   Siguiente
    
    .ui.segment.keyIdeasSegment.hidden
      h3.ui.header
        i.key.blue.icon
        .content Ideas clave
      .sub.header.grayElement 
        i.hand.pointer.icon
        span Selecciona cada palabra para aprender más
      br
    
      .ui.stackable.two.column.grid
        .ui.column
          .keyTerm.ui.raised.segment.voiceover_keyTerm1
            a.ui.blue.ribbon.label.keyTermLabel
                span Audiencia
            span.hidden.keyTermDefinition Cualquier persona que pueda ver información sobre ti o publicada por ti en internet.
        .ui.column
          .keyTerm.ui.raised.segment.voiceover_keyTerm2
            a.ui.blue.ribbon.label.keyTermLabel
                span Anónimo
            span.hidden.keyTermDefinition Mantener ocultos tu nombre y tu identidad en línea.
              ul A veces la gente usa finstas para publicar de forma anónima.    
        .ui.column
          .keyTerm.ui.raised.segment.voiceover_keyTerm3
            a.ui.blue.ribbon.label.keyTermLabel
                span Curar
            span.hidden.keyTermDefinition Elegir y organizar lo que publicas en redes sociales.
              ul Algunas personas mantienen su cuenta principal muy cuidada, mientras publican con más soltura en una cuenta anónima.       
    
    
    .ui.warning.message#clickNextWarning
      .header
       | Clic "Siguiente"
    .ui.warning.message#clickLabelsWarning
     .header
      | Dale clic a cada etiqueta para continuar   
    a(href='javascript:void(0);', onclick='javascript:clickGotIt();')
      .ui.labeled.icon.button
          i.rocket.icon
          |   Entendido

block scripts
  script.
    var voiceoverMappings = {
      '.showLearnSectionButton': {
        "initialDelay": 700,
        "delay": 500,
        "files": ['CUSML.12.1.1.mp3','CUSML.12.1.2.mp3']
      },
      '.voiceover_keyTerm1': {
        "initialDelay": 700,
        "delay": 0,
        "files": ['CUSML.12.2.1.mp3']
      },
      '.voiceover_keyTerm2': {
        "initialDelay": 700,
        "delay": 0,
        "files": ['CUSML.12.2.2.mp3']
      },
      '.voiceover_keyTerm3': {
        "initialDelay": 700,
        "delay": 0,
        "files": ['CUSML.12.2.3.mp3']
      }
    };
  script(src='/module_js/voiceover.js')
  script(src="/module_js/base_start.js?v=3")
  
block styles
  link(rel='stylesheet', href='/css/start.css')
  

