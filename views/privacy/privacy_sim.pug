extends ../ui_layout

block content
  
  .computer.only.tablet.only.four.wide.column 
  .eight.wide.computer.ten.wide.tablet.sixteen.wide.mobile.column()
    .ui.one.column.centered.grid.feedbackMessagesGrid.sim-privacy-feedback
      .ui.fixed.bottom.sticky
        .ui.icon.compact.hidden.message.warning#clickNextHelpMessage
          i.close.icon
          i.question.icon.float
          .content
            .ui.header Need some help?
            p Scroll up and click "Next" to begin!
        .ui.icon.compact.message.warning#removeHidden
          i.close.icon
          i.question.icon.float
          .content
            .ui.header Need some help?
            p Once the blue dots appear, open each one and click “Got it” before using the bottom button.
          
        .ui.icon.message.warning#clickAllDotsWarning
          i.close.icon
          i.hand.pointer.icon.float
          .content
            .ui.header There are still blue dots to find!
            p There are five blue dots on this page—open each and click “Got it.” The bottom button then turns green so you can continue (you don’t have to fill in every dropdown).
            
    #step1.ui.container.addTopMargin
      h2.ui.header Privacy Settings
      br
      .ui.divider
      br
      form.ui.form
        .grouped.fields#hint1
          label.sectionTitle(for='account') Account Settings
          .field#hint2
            br
            .ui.toggle.checkbox(name='publicToggle')
              input#privacySimIsPrivate(type='checkbox' name='isPrivate')
              label(for='privacySimIsPrivate') Private account
          span.settingSmallLabel When your account is private, only people you approve can see your posts.
          br
          br
            
      .ui.divider
      br
      form.ui.form
        .grouped.fields
            label.sectionTitle(for='interaction') Interaction Settings
            br
            br
            label.subsectionTitle(for='contacts') Contacts
            .field#hint3
              br
              label.standardLabel(for='privacySimFriendRequests') Allow friend requests from
              select.ui.fluid.dropdown.privacy-sim-single#privacySimFriendRequests(name='friendRequests')
                option(value='') Select
                option(value='0') Everyone
                option(value='1') Friends of Friends
            br
            .field
              label.standardLabel(for='privacySimFriendList') Who can see my friends list?
              select.ui.fluid.dropdown.privacy-sim-single#privacySimFriendList(name='friendList')
                option(value='') Select
                option(value='0') Everyone
                option(value='1') Friends of Friends
                option(value='2') Friends
                option(value='3') Only Me
            br
            label.subsectionTitle(for='comments') Comments
            .field
              br
              label.standardLabel(for='privacySimCommentsList') Allow comments from
              select.ui.fluid.dropdown.privacy-sim-single#privacySimCommentsList(name='commentsList')
                option(value='') Select
                option(value='0') Everyone
                option(value='1') Friends of Friends
                option(value='2') Friends
                option(value='3') Only Me
            br
            .field
              label.standardLabel Block comments from
              .div
                select.ui.fluid.search.dropdown.blocklistDropdown(multiple='')
                  option Fake N. Ame
                  option Ima Robot
                  option Cloe Hansen
                  option Hayden Abbey
                  option Kiki Pualani
                  option Elli Andreas
                  option Lauren Wakefield
                  option Rob Yang
                  option Katherine Zhou
                  option Franklin Robinson
                  option Aidan Acosta
                  option Shika Ramphal
                  option Jason Perez
                  option Sarah Stella
                  option Keith Hernandez
                  option Elena Anderson
                  option Mary Beckett
                  option Ethan Kravitz
                  option Dylan Moore
                  option David Cole
                  option Lana Sheehan
                  option Claire Johnson
                  option Jenny Chen
                  option Ella Sroni
            br
            label.subsectionTitle(for='tags') Tags
            .field
              br
              .ui.toggle.checkbox(name='tagToggle1')
                input(type='checkbox' name='allowTags' checked='checked')
                label Allow people to tag me in their posts
            .field
              .ui.toggle.checkbox(name='tagToggle2')
                input(type='checkbox' name='addTags' checked='checked')
                label Automatically add tagged posts in my timeline
              br
              br
      .ui.divider
      br
      form.ui.form
        .grouped.fields
            label.sectionTitle(for='information') Location Sharing Settings
            .field#hint4
              br
              .ui.toggle.checkbox(name='locationToggle')
                input(type='checkbox' name='shareLocation' checked='checked')
                label Turn on location sharing
            .field#hint5
              br
              label.standardLabel(for='privacySimShareLocationWith') Share my location with
              select.ui.fluid.dropdown.privacy-sim-single#privacySimShareLocationWith(name='shareLocationWith')
                option(value='') Select
                option(value='0') Everyone
                option(value='1') Friends of Friends
                option(value='2') Friends
                option(value='3') Only Me
            br
            .ui.divider
            br
    .ui.message.warning.hidden#confirmContinueCheck
      .ui.header 
        | Are you sure you do not want to try changing some privacy settings before continuing?
    button.ui.big.labeled.icon.button.privacytrans2.addBottomMargin#cyberTransButton
          i.rocket.icon
          |   Let's Continue!

block scripts
  //- If the module bundle 404s, base_sim.js still parses (privacy-only fallback).
  script.
    if (typeof hintsList === 'undefined') { var hintsList = []; }
    if (typeof stepsList === 'undefined') { var stepsList = []; }
  script(src="/module_js/privacy/privacy_sim.js")
  script(src="/module_js/voiceover.js")
  script(src="/module_js/base_sim.js")
    
block styles
  link(rel='stylesheet', href='/css/sim.css')
  link(rel='stylesheet', href='/css/modules/privacy.css')
