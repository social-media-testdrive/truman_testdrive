                   a.like Me gusta
                   a.flag Reportar   
         .extra.content
           .ui.fluid.left.labeled.right.icon.input
             .ui.label
               img.ui.avatar.image(src=(user && user.profile && user.profile.picture) ? (cdn + '/profile_pictures/' + user.profile.picture) : (cdn + '/profile_pictures/avatar-icon.svg'), name=(user && user.profile && user.profile.name) ? user.profile.name : 'Usuario')
             input.newcomment(type='text' placeholder='Escribir un comentario')
             i.big.send.link.icon 
       
       .ui.fluid.card.dim()
         .ui.dimmer.flag
           .content
             .center
