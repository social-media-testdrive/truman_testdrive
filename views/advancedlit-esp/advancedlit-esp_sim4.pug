extends ../ui_layout-esp

block content

  #content.sixteen.wide.column.centered.addBottomMargin
   //- #####################################################
   .ui.one.column.centered.grid.feedbackMessagesGrid
     .ui.fixed.bottom.sticky
       .ui.icon.compact.message.warning.hidden#removeHidden
         i.close.icon
         i.question.icon.float
         .content
           .ui.header ¿Necesitas ayuda?
           p ¡Asegúrate de que estás haciendo clic en "Entendido" en los puntos azules!
         
       .ui.icon.message.warning.hidden#clickAllDotsWarning
         i.close.icon
         i.hand.pointer.icon.float
         .content
           .ui.header ¡Todavía quedan puntos azules por encontrar!
           p Haz clic en todos los puntos azules para seguir.

   .ui.grid.gridInsideTab
     .eight.wide.computer.ten.wide.tablet.sixteen.wide.mobile.column.centered
       
       .ui.fluid.card.dim()#step1
         .ui.dimmer.flag
           .content
             .center
               h2.ui.inverted.icon.header
                 i.red.flag.icon
                 | ¡Has reportado esto!
                 h3.ui.inverted.header
                   span 
                     | Los administradores del TestDrive van a revisar el post luego.
         .content
           .right.floated.meta= "Hace 10 minutos"
           a
             img.ui.avatar.image(src=cdn+'/profile_pictures/user47.jpeg')
             span='María Teresa Hernandez'
         .img.post.articleImage.articleTab(data-tab="two")        
           img(src=cdn+'/post_pictures/dog_an.jpg')

         .content.articleTab(data-tab="two")
           .description
             | Tengo el perro más lindo del universo. 🐶❤️
         .four.ui.bottom.attached.icon.buttons
           .ui.reply.button(tabindex='0')
             i.reply.icon
             | Responder
           .ui.flag.button(tabindex='0')
             i.flag.icon
             | Reportar
           .ui.labeled.button(tabindex='0')
             .ui.like.button
               i.heart.icon
               | Me gusta
             a.ui.basic.red.left.pointing.label.count 0
         .content
           .ui.comments
             .comment
               a.avatar
                 img(src=cdn+'/profile_pictures/user19.jpg')
               .content
                 a.author Daniel Ríos
                 .metadata
                   span.date Hace un minuto
                   i.heart.icon
                   |  0 me gusta
                 .text()
                   | ¡Tienes razón!
                 .actions
                   a.like Me gusta
                   a.flag Reportar     
             .comment
