block scripts
  script.
    var stepsList = [
      {
        element: '#step1',
        intro: `Clic a \“Siguiente”\ para comenzar`,
        position: 'right',
        scrollTo: 'tooltip',
        audioFile: ['']
      },
      {
        element: '#step1',
        intro: `Este es el perfil de Lucía Schang, una estudiante de escuela intermedia.`,
        position:'right',
        scrollTo:'tooltip',
        audioFile: ['CUSML.7.8.01.mp3']
      },
      {
        element: document.querySelectorAll('#step1')[0],
        intro: `Así es como verá el perfil de Lucía cualquier persona en el internet.`,
        position:'right',
        scrollTo:'tooltip',
        audioFile: ['CUSML.7.8.02.mp3']
      },
      {
        element: document.querySelectorAll('#step1')[0],
        intro: `¡Tómate tu tiempo para revisar y ver qué tipo de posts tiene en su perfil!`,
        position:'right',
        scrollTo:'tooltip',
        audioFile: ['CUSML.7.8.03.mp3']
      },
      {
        element: document.querySelectorAll('#step1')[0],
        intro: `Dale clic a "Listo" y busca los puntos azules&nbsp;&nbsp;<a role='button' tabindex='0' class='introjs-hint'><div class='introjs-hint-dot'></div><div class='introjs-hint-pulse'></div></a> &nbsp; &nbsp; &nbsp; &nbsp; para aprender más...`,
        position:'right',
        scrollTo:'tooltip',
        audioFile: ['CUSML.7.8.04.mp3']
      }
    ];

    var hintsList = [
      {
        hint: `Recuerda, así es como ve el perfil de Lucía cualquier persona en el internet. Todos sus posts se pueden ver en su página de perfil.`,
        element: '#hint1',
        hintPosition: 'middle-middle',
        // audioFile: ['CUSML.7.8.05.mp3']
      },
      {
        hint: `Piensa en lo que puedes aprender sobre Lucía ¿Cuáles son algunos de sus pasatiempos? ¿A dónde le gusta ir? ¿Quiénes son sus amigos?`,
        element: '#hint2',
        hintPosition: 'middle-right',
        // audioFile: ['CUSML.7.8.06.mp3']
      },
      {
        hint: `Lucía ha compartido información de su ubicación en sus posts. La información de su ubicación también está disponible para cualquier persona en internet.`,
        element: '#hint3',
        hintPosition: 'middle-right',
        // audioFile: ['CUSML.7.8.07.mp3']
      }
    ];

  script(src="/module_js/voiceover.js")
