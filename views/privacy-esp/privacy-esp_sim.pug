extends ../ui_layout-esp

block content
  
  .computer.only.tablet.only.four.wide.column 
  .eight.wide.computer.ten.wide.tablet.sixteen.wide.mobile.column()
    .ui.one.column.centered.grid.feedbackMessagesGrid.sim-privacy-feedback
      .ui.fixed.bottom.sticky
        .ui.icon.compact.hidden.message.warning#clickNextHelpMessage
          i.close.icon
          i.question.icon.float
          .content
            .ui.header ¿Necesitas ayuda?
            p Sube hasta el mensaje del tour y usa «Siguiente» para avanzar; en el último paso aparece «Listo» y luego los puntos azules.
        .ui.icon.compact.message.warning#removeHidden
          i.close.icon
          i.question.icon.float
          .content
            .ui.header ¿Necesitas ayuda?
            p Cuando aparezcan los puntos azules, abre cada uno y pulsa “¡Entendido!” antes de usar el botón de abajo.
          
        .ui.icon.message.warning#clickAllDotsWarning
          i.close.icon
          i.hand.pointer.icon.float
          .content
            .ui.header ¡Todavía quedan puntos azules por encontrar!
            p Hay cinco puntos azules en esta página. Ábrelos todos y haz clic en “¡Entendido!” en cada ventana; entonces el botón inferior se pondrá verde para continuar (no tienes que rellenar todos los menús).
            
    #step1.ui.container.addTopMargin
      h2.ui.header Configuraciones de privacidad
      br
      .ui.divider
      br
      form.ui.form
        .grouped.fields#hint1
          label.sectionTitle(for='account') Configuraciones de cuenta
          .field#hint2
            br
            .ui.toggle.checkbox(name='publicToggle')
              input#privacySimIsPrivate(type='checkbox' name='isPrivate')
              label(for='privacySimIsPrivate') Cuenta Privada
          span.settingSmallLabel Cuando su cuenta es privada, solo las personas que usted aprueba pueden ver sus publicaciones.
          br
          br
            
      .ui.divider
      br
      form.ui.form
        .grouped.fields
            label.sectionTitle(for='interaction') Configuraciones de Interacción
            br
            br
            label.subsectionTitle(for='contacts') Contactos
            .field#hint3
              br
              label.standardLabel(for='privacySimFriendRequests') Permitir solicitudes de amistad de
              select.ui.fluid.dropdown.privacy-sim-single#privacySimFriendRequests(name='friendRequests')
                option(value='') Seleccionar
                option(value='0') Todos
                option(value='1') Amigos de amigos
            br
            .field
              label.standardLabel(for='privacySimFriendList') ¿Quién puede ver mi lista de amigos?
              select.ui.fluid.dropdown.privacy-sim-single#privacySimFriendList(name='friendList')
                option(value='') Seleccionar
                option(value='0') Todos
                option(value='1') Amigos de amigos
                option(value='2') Amigos
                option(value='3') Solo yo
            br
            label.subsectionTitle(for='comments') Comentarios
            .field
              br
              label.standardLabel(for='privacySimCommentsList') Permitir comentarios de
              select.ui.fluid.dropdown.privacy-sim-single#privacySimCommentsList(name='commentsList')
                option(value='') Seleccionar
                option(value='0') Todos
                option(value='1') Amigos de amigos
                option(value='2') Amigos
                option(value='3') Solo yo
            br
            .field
              label.standardLabel Bloquear comentarios de
              .div
                select.ui.fluid.search.dropdown.blocklistDropdown(multiple='')
                  option Nombre F.
                  option Soyun Robot
                  option Carolina Jara
                  option María Cristina Rodríguez
                  option Ana Pereira
                  option Sandra Gómez
                  option Laura Ochoa
                  option Roberto Sánchez
                  option Juana Ramirez
                  option Alonso Contreras
                  option Camilo Rojas
                  option Carmen García
                  option Julio César Hernandez
                  option Sara Segovia
                  option Luis Alberto Torres
                  option Eugenia Espósito
                  option María Villalobos
                  option Antonio Da Silva
                  option Daniel Ríos
                  option David López
                  option Valery Reyes
                  option Maria Alejandra Sanchez
                  option Milagros Cardenas
                  option Valeria Vargas
            br
            label.subsectionTitle(for='tags') Etiquetas
            .field
              br
              .ui.toggle.checkbox(name='tagToggle1')
                input(type='checkbox' name='allowTags' checked='checked')
                label Permitir etiquetas
            .field
              .ui.toggle.checkbox(name='tagToggle2')
                input(type='checkbox' name='addTags' checked='checked')
                label Agregar automáticamente publicaciones etiquetadas a mi feed
              br
              br
      .ui.divider
      br
      form.ui.form
        .grouped.fields
            label.sectionTitle(for='information') Configuración de ubicación
            .field#hint4
              br
              .ui.toggle.checkbox(name='locationToggle')
                input(type='checkbox' name='shareLocation' checked='checked')
                label Activar la función de compartir ubicación
            .field#hint5
              br
              label.standardLabel(for='privacySimShareLocationWith') Compartir mi ubicación con
              select.ui.fluid.dropdown.privacy-sim-single#privacySimShareLocationWith(name='shareLocationWith')
                option(value='') Seleccionar
                option(value='0') Todos
                option(value='1') Amigos de amigos
                option(value='2') Amigos
                option(value='3') Solo yo
            br
            .ui.divider
            br
    .ui.message.warning.hidden#confirmContinueCheck
      .ui.header 
        | ¿Estás seguro de que no quieres hacer algún cambio en la configuración de tu privacidad antes de continuar?
    button.ui.big.labeled.icon.button.privacyesptrans2.addBottomMargin#cyberTransButton
          i.rocket.icon
          |   ¡Listo!

block scripts
  //- If the module bundle 404s, base_sim.js still parses (privacy-only fallback).
  script.
    if (typeof hintsList === 'undefined') { var hintsList = []; }
    if (typeof stepsList === 'undefined') { var stepsList = []; }
  script(src="/module_js/privacy-esp/privacy-esp_sim.js")
  script(src="/module_js/voiceover.js")
  script(src="/module_js/base_sim.js")
    
block styles
  link(rel='stylesheet', href='/css/sim.css')
  link(rel='stylesheet', href='/css/modules/privacy.css')